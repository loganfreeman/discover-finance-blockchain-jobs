{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GenerateWeeklyMarketReportInput",
  "type": "object",
  "properties": {
    "target_roles": {
      "type": "array",
      "items": { "type": "string" }
    },
    "industries": {
      "type": "array",
      "items": { "type": "string" }
    },
    "location": { "type": "string" },
    "remote_preference": { "type": "string" },
    "seniority": { "type": "string" },
    "skills": {
      "type": "array",
      "items": { "type": "string" }
    },
    "sample_size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "include_compensation": { "type": "boolean" },
    "include_interview_prep": { "type": "boolean" }
  },
  "required": ["target_roles"],
  "additionalProperties": true
}


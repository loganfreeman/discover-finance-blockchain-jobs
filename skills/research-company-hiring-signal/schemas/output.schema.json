{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ResearchCompanyHiringSignalOutput",
  "type": "object",
  "properties": {
    "generated_at": { "type": "string" },
    "company": { "type": "string" },
    "category": { "type": "string" },
    "recommendation": {
      "type": "string",
      "enum": ["Apply now", "Apply selectively", "Monitor", "Deprioritize"]
    },
    "summary": { "type": "string" },
    "open_roles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": { "type": "string" },
          "url": { "type": "string" },
          "location": { "type": "string" },
          "fit_note": { "type": "string" }
        }
      }
    },
    "positive_signals": {
      "type": "array",
      "items": { "type": "string" }
    },
    "risk_signals": {
      "type": "array",
      "items": { "type": "string" }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": { "type": "string" },
          "url": { "type": "string" },
          "retrieved_at": { "type": "string" }
        },
        "required": ["label", "url"]
      }
    }
  },
  "required": ["generated_at", "company", "recommendation"],
  "additionalProperties": true
}

